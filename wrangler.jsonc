// The Sympal waitlist page: the files in public/, and a small Worker for the
// one request they cannot answer, the form. Deployed with `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name of the Worker already serving sympal.ahm.et: deploys update it
  // in place, and keep its domain.
  "name": "sympal-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The home page goes through the Worker first, so /?open=beta can send
    // people straight to the TestFlight invite (see src/worker.js).
    "run_worker_first": ["/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sympal-waitlist",
      "database_id": "c3a67300-866c-454c-aac8-f2ef467c9559"
    }
  ],
  // A mail to the maker for each new address. Needs Email Routing on ahm.et
  // and this address verified there; it can write to no other.
  "send_email": [
    {
      "name": "NOTIFY",
      "destination_address": "abavcilar@gmail.com"
    }
  ]
}
